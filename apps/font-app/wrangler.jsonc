{
  "name": "jck-font",
  "compatibility_date": "2024-01-01",

  // Pages configuration
  "pages_build_output_dir": "dist",

  // D1 Database binding
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "jck-font-db",
      "database_id": "fae6006c-da87-455d-854a-4ac8a34e34ee"
    }
  ],

  // R2 Storage binding
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "jck-font-storage"
    }
  ]
}
